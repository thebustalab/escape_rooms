      "entry": {
        "title": "The beacon that won't quit",
        "text": "North_Killeak — the high-chloride lake — is where the search party flew. You suit up in the helipad prep room and wait. Hours pass. No one returns. But on the beacon rack, the missing pilot's signal is still pulsing. There's an additional helicopter, Claire's, on the pad outside. If the beacon is still alive after all this time, maybe everyone flew to the wrong lake — and only you can work out the one where the lost pilot actually is.",
        "button": "Step into the beacon room  →"
      },
      "panorama": "boss/scene.png",
      "panoramaOpen": "boss/scene_open.png",
      "wrap": {
        "haov": 360,
        "vaov": 90,
        "hfov": 120,
        "vOffset": -9,
        "pitch": -10.3
      },
      "hotspots": [
        {
          "id": "the_workbench_laptop",
          "type": "puzzle",
          "label": "The workbench laptop",
          "box": [
            0.4251,
            0.5281,
            0.4652,
            0.6324
          ],
          "starterCode": "alaska_lake_data",
