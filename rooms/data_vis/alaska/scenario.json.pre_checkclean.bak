{
  "chapter": "data_vis",
  "scenario": "alaska",
  "id": 6,
  "title": "Signal in the Cold",
  "subtitle": "Data Visualization · filter() + plotting",
  "story": "You're a trainee data analyst and helicopter pilot at a remote Alaskan field station, in for a routine afternoon of water chemistry work. But somewhere out on the tundra a pilot has gone missing — and by the time you reach the helipad, you're the only one left who can work out where they really are. Can you save the day?",
  "enterLabel": "Start your shift →",
  "done": {
    "title": "The pilot is found!",
    "body": "You figured out that the lost pilot is at Lava Lake while everyone else searched the frozen high-chloride site. Nice reading of the numbers, life saver!"
  },
  "music": "audio/arnalds_hafursey.mp3",
  "musicVolume": 0.1,
  "musicCredit": {
    "text": "Ólafur Arnalds — live from Hafursey (Cercle)",
    "url": "https://www.youtube.com/watch?v=bMCiAKNUpTY"
  },
