            "plotCode": "p <- ggplot(dplyr::filter(alaska_lake_data, element == \"Cl\"),\n            aes(reorder(lake, mg_per_L), mg_per_L)) +\n     ggiraph::geom_col_interactive(aes(data_id = lake, tooltip = lake)) +\n     coord_flip() +\n     labs(x = NULL, y = \"Chloride (mg/L)\")",
            "answer": "North_Killeak_Lake",
